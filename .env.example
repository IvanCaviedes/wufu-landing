# Sitio y marca (públicas; se incorporan durante `next build`)
NEXT_PUBLIC_SITE_URL=https://wufu.co
NEXT_PUBLIC_BRAND_NAME=Wufú
NEXT_PUBLIC_CAMPAIGN_YEAR=2026
# Fases automáticas: prelaunch antes de PRELAUNCH_END_AT, launch hasta LAUNCH_AT y open después.
# LANDING_PHASE permite forzar manualmente: auto (vacío), prelaunch, launch u open.
LANDING_PHASE=
PRELAUNCH_END_AT=2026-12-01T00:00:00-05:00
LAUNCH_AT=2027-01-01T00:00:00-05:00
OPENING_LOCATION=Ubicación por anunciar
OPENING_HOURS=Horario por anunciar
# Temporadas: deja SEASON_OVERRIDE vacío para activarlas automáticamente por fecha.
# Valores manuales: none, halloween o christmas.
SEASON_OVERRIDE=
HALLOWEEN_START_AT=2026-10-01T00:00:00-05:00
HALLOWEEN_END_AT=2026-11-03T00:00:00-05:00
CHRISTMAS_START_AT=2026-12-01T00:00:00-05:00
CHRISTMAS_END_AT=2027-01-07T00:00:00-05:00
NEXT_PUBLIC_CAMPAIGN_CODE=MANADA01
NEXT_PUBLIC_SECRET_WORD=wufu
GOOGLE_SITE_VERIFICATION=

